# =====================================================
# SmartTechBuddy Input Distribution - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your actual values

# =====================================================
# DEVELOPMENT/DEPLOYMENT MODE
# =====================================================
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# =====================================================
# JWT AUTHENTICATION (Role-Based Access Control)
# =====================================================
# Secret used to sign JWT tokens — change to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRY_HOURS=8

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# For Development (SQLite):
DATABASE_URL=sqlite:///smarttech_dev.db

# For Production (PostgreSQL):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smarttech_input_db

# =====================================================
# DATA SOURCE CONFIGURATION (CRITICAL FOR GROWFORME INTEGRATION)
# =====================================================
# Choose your data source:
# - 'mock': Use dummy data for development/testing (DEFAULT)
# - 'growforme_api': Connect to GrowForMe's existing API
DATA_SOURCE=mock

# =====================================================
# GROWFORME SYSTEM INTEGRATION (Only if DATA_SOURCE=growforme_api)
# =====================================================
# When ready to connect to GrowForMe's existing system:
# 1. Set DATA_SOURCE=growforme_api
# 2. Configure the API endpoint and authentication below
# 3. The system will fetch real inventory, farmer, and order data

# GrowForMe Inventory/Input Acquisition API
GROWFORME_API_URL=https://api.growforme.com/api/v1
GROWFORME_API_KEY=your-growforme-api-key-here

# GrowForMe Database Connection (direct access if needed)
GROWFORME_DATABASE_URL=postgresql://user:password@growforme-db-host:5432/growforme_db

# =====================================================
# REDIS CONFIGURATION (For Caching & Task Queue)
# =====================================================
REDIS_URL=redis://localhost:6379/0

# =====================================================
# TWILIO SMS CONFIGURATION (Farmer Notifications)
# =====================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# CORS CONFIGURATION
# =====================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=50

# =====================================================
# CORE INPUTS SUPPORTED
# =====================================================
# The system manages these input types:
# 1. SEEDS - Certified seed varieties
# 2. FERTILIZER_BASAL - Base/primary fertilizer application
# 3. FERTILIZER_TOP_DRESSING - Secondary/top dressing application
# 4. MECHANIZATION - Farm equipment, machinery, tools
# 5. CHEMICAL - Pesticides, herbicides, fungicides
# 6. OTHER - Any other agricultural inputs

# =====================================================
# ROUTING ALGORITHM CONFIGURATION
# =====================================================
MAX_ORDERS_PER_BATCH=50
OPTIMAL_ROUTE_DISTANCE_KM=100
MAX_DELIVERY_STOPS_PER_ROUTE=30
